# ================================================================
# Razorpay Credentials
# ================================================================
# Test Mode: starts with rzp_test_
# Live Mode: starts with rzp_live_ (Dashboard -> Live Mode -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_U0slt7fuBjAcDF
RAZORPAY_KEY_SECRET=Ia9idCpAivjzY0sUNx8r8mim

# ================================================================
# Webhook Secret
# ================================================================
# Dashboard -> Account & Settings -> Webhooks -> Add Webhook
# URL: https://<your-backend-domain>/api/payments/webhook
# Active Events: payment.captured, refund.processed
RAZORPAY_WEBHOOK_SECRET=change_me

# ================================================================
# CORS Origins
# ================================================================
# Comma-separated list or JSON array of allowed frontend URLs
# In production, set this to your deployed frontend domain (e.g. https://your-frontend.vercel.app)
CORS_ORIGINS=["http://localhost:5173"]

# ================================================================
# Database
# ================================================================
DATABASE_PATH=orders.db
